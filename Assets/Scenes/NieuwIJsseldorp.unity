    speakerPFP: {fileID: 0}
  - speakerName: Renske
    dialogue: Hey! Let's ride this into battle!
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: c9817088143128f4092e0bb66063a170, type: 3}
  - speakerName: Charlie
    dialogue: I wish, too bad the recoil of that railway cannon it was pushing managed
      to damage it. Should be fixed soon though.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: 812f1a892b8cf294a9b69afdab8a83a1, type: 3}
  - speakerName: Renske
    dialogue: How old is this thing anyways.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: c9817088143128f4092e0bb66063a170, type: 3}
  - speakerName: Charlie
    dialogue: Definitely built long after either of us were born... I think it was
      built a good 160 years ago I'd say.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: 812f1a892b8cf294a9b69afdab8a83a1, type: 3}
  isHumanoidOrAnimal: 0
  scriptToActivate: {fileID: 0}
