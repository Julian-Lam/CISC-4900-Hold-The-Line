--- !u!114 &8256623041830919752
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8256623041830919751}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e455bdf3ce136ca4a81ea5f925dc5178, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  charName: Basil Avery
  firstTimeInteractionName: ???
  timesInteractedWith: 0
  dialogueLines:
  - speakerName: ???
    dialogue: Hi! Uhh... Who are you?
    appearOnlyInFirstInteraction: 1
    speakerPFP: {fileID: 21300000, guid: e625e696e814a2148945002fcbaccf1d, type: 3}
  - speakerName: Charlie
    dialogue: Name's Charlie. Guessin' you're the temporary airstrike pilot here?
    appearOnlyInFirstInteraction: 1
    speakerPFP: {fileID: 21300000, guid: 812f1a892b8cf294a9b69afdab8a83a1, type: 3}
  - speakerName: Basil
    dialogue: Yep! My name is Basil Avery!
    appearOnlyInFirstInteraction: 1
    speakerPFP: {fileID: 21300000, guid: e625e696e814a2148945002fcbaccf1d, type: 3}
  - speakerName: Basil
    dialogue: What'd you think of my plane, eh? It's a new Spatz model.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: e625e696e814a2148945002fcbaccf1d, type: 3}
  - speakerName: Charlie
    dialogue: Neat, reminds me of the planes back in the day. Damn, maybe I should
      get one, a P-47 perhaps. I wonder if Wagner can replicate some World War II
      American equipment...
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: 812f1a892b8cf294a9b69afdab8a83a1, type: 3}
  - speakerName: Basil
    dialogue: Uhh... so apparently, this is an uncharted region of New York, airspace
      included, right?
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: e625e696e814a2148945002fcbaccf1d, type: 3}
  - speakerName: Charlie
    dialogue: Long story, I should tell you one day. But it is why you were sent
      alone.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: 812f1a892b8cf294a9b69afdab8a83a1, type: 3}
  - speakerName: Basil
    dialogue: Okay... Just mark where you want me to attack with a flare and I'll
      take care of it!
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: e625e696e814a2148945002fcbaccf1d, type: 3}
  - speakerName: Charlie
    dialogue: Just... please do, I ain't trying to die a second time!
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: 812f1a892b8cf294a9b69afdab8a83a1, type: 3}
  isHumanoidOrAnimal: 1
  scriptToActivate: {fileID: 8256623041830919753}
