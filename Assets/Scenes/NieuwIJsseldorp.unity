  m_Script: {fileID: 11500000, guid: e455bdf3ce136ca4a81ea5f925dc5178, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  charName: Renske's Laptop
  firstTimeInteractionName: 
  timesInteractedWith: 0
  dialogueLines:
  - speakerName: 
    dialogue: The screen fills up with a cute, cartoonish background depicting peaceful
      village life.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Charlie
    dialogue: Damn Renske, you still like that baby show?
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: 812f1a892b8cf294a9b69afdab8a83a1, type: 3}
  - speakerName: Renske
    dialogue: Ehe... Makes me think of home, before I di-*hiccup* and it was abandoned...
      and overrun... by... creatures...
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: c9817088143128f4092e0bb66063a170, type: 3}
  - speakerName: Charlie
    dialogue: Don't worry, we'll make sure New Isselville looks like new again. It
      is the most we can do.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 21300000, guid: 812f1a892b8cf294a9b69afdab8a83a1, type: 3}
  isHumanoidOrAnimal: 0
  scriptToActivate: {fileID: 0}
