  m_Script: {fileID: 11500000, guid: e455bdf3ce136ca4a81ea5f925dc5178, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  charName: Damanged NYC Subway Car
  firstTimeInteractionName: 
  timesInteractedWith: 0
  dialogueLines:
  - speakerName: Damaged NYC Subway Car
    dialogue: ...
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Renske
    dialogue: Hey! Let's ride this into battle!
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Charlie
    dialogue: I wish, too bad the recoil of that railway cannon it was pushing managed
      to damage it. Should be fixed soon though.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Renske
    dialogue: How old is this thing anyways.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Charlie
    dialogue: Definitely built long after I was born... which is a low bar.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  isHumanoidOrAnimal: 0
