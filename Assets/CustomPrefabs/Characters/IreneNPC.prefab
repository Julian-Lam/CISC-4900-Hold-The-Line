--- !u!114 &8962288754094176415
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6694117644888477636}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e455bdf3ce136ca4a81ea5f925dc5178, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  charName: Irene Vanderkleij
  firstTimeInteractionName: 
  timesInteractedWith: 0
  dialogueLines:
  - speakerName: Irene
    dialogue: Good afternoon.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Renske
    dialogue: Hi auntie!
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Irene
    dialogue: Heh... you'd be the auntie...
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Charlie
    dialogue: What's up captain? Anything for us to do right now?
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Irene
    dialogue: Yes... Ugh... Those bastard mutants are popping up even more.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Charlie
    dialogue: Figured since Aleksey, Luk'yan, Vasilka, and those other mercenary
      kids were redeployed to Fort Wadsworth in Staten Island.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Irene
    dialogue: I understand they have their reasons... But still.
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Irene
    dialogue: Anyways... You know the drill for today. Just take out the mutants
      and any suspicious characters in and around the village of New Isselville.
      Renske, you know the streets of this village better than all of us. I'm sure
      you can help direct Charlie?
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  - speakerName: Renske
    dialogue: Aye-eye captain!
    appearOnlyInFirstInteraction: 0
    speakerPFP: {fileID: 0}
  isHumanoidOrAnimal: 1
